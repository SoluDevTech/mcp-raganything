# ecdsa: Minerva attack - no fixed version available (status: affected)
# Transitive dependency via authlib. Monitor for upstream fix.
CVE-2024-23342

# libsqlite3-0: Fix upstream (SQLite 3.42.0) non backporté par Debian bookworm.
# Pas de DSA émis. Integer overflow dans sqlite3KeyInfoFromExprList.
# Review: 2026-04-24
CVE-2025-7458

# zlib1g: MiniZip n'est pas compilé dans le paquet zlib Debian.
# Faux positif confirmé par le tracker Debian (will_not_fix).
# Review: 2026-04-24
CVE-2023-45853

# libssh2-1: integer overflow via large username/password - no fixed version available (status: affected).
# Debian bookworm package not yet patched. Monitor for upstream fix.
# Review: 2026-05-20
CVE-2026-7598

# starlette 0.52.1: Host header bypass. Fixed in starlette 1.0.1, but blocked by
# `raganything>=1.2.10` -> `mineru[core]` -> `gradio<6.9.0` -> `starlette<1.0`.
# No Starlette 1.x-compatible `mineru`/`gradio` pair is available on PyPI.
# Re-evaluate when `gradio>=6.9.0` ships or `raganything` drops `mineru[core]`.
# Review: 2026-06-12
CVE-2026-48710

# transformers 4.57.6: Arbitrary code execution via malicious checkpoint.
# Fixed in 5.0.0rc3 (pre-release). We pin to the stable 4.x line and skip the
# RC. Re-evaluate when 5.0.0 stable is released.
# Review: 2026-06-12
CVE-2026-1839

# perl-base (bookworm & trixie): Archive::Tar symlink path-traversal.
# Exploitable only by code that calls `Archive::Tar` on attacker-controlled
# archives; this FastAPI service does not invoke Perl or Archive::Tar.
# `apt-cache rdepends --installed perl-base` returns nothing in
# `python:3.13-slim-bookworm` + our apt-get install layer. Status: fix_deferred
# upstream; needs Perl 5.44 backport. Re-evaluate on image rebuild after Debian
# ships the fix.
# Review: 2026-06-12
CVE-2026-42496

# perl-base (bookworm & trixie): heap buffer overflow in the Perl compiler
# during compilation. Exploitable only by code that invokes `perl` as a
# compiler on attacker-controlled input; this service does not call Perl.
# Status: affected upstream; needs Perl 5.44 backport.
# Review: 2026-06-12
CVE-2026-8376

